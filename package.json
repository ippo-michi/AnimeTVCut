{
  "name": "animetvcut",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx apps/server/src/server.ts",
    "fixtures:generate": "bash scripts/generate-fixtures.sh",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check .",
    "start": "node apps/server/dist/server.js",
    "test": "pnpm fixtures:generate && vitest run",
    "test:integration": "pnpm fixtures:generate && vitest run apps/server/tests/integration.test.ts apps/server/tests/fmp4-integration.test.ts",
    "test:mediaflow": "bash scripts/run-mediaflow-integration.sh",
    "test:upstream": "bash scripts/run-upstream-integration.sh",
    "test:skip": "bash scripts/run-skip-integration.sh",
    "test:stremio": "bash scripts/run-stremio-integration.sh",
    "test:subtitles": "bash scripts/run-subtitle-integration.sh",
    "test:aiostreams:live": "vitest run --config vitest.aiostreams-live.config.ts",
    "test:introdb:live": "vitest run --config vitest.introdb-live.config.ts",
    "test:aniskip:live": "vitest run --config vitest.aniskip-live.config.ts",
    "test:aiometadata:live": "vitest run --config vitest.metadata-live.config.ts",
    "test:cinemeta:live": "vitest run --config vitest.metadata-live.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}

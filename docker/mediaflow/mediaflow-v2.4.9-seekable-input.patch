+    def pyav_open_input(self) -> tuple[str, dict[str, str]]:
+        """Return a seekable FFmpeg/PyAV HTTP input without exposing it publicly."""
+        forwarded = []
+        for raw_name, raw_value in self._headers.items():
+            name = str(raw_name).strip()
+            value = str(raw_value).strip()
+            if not name or any(ch in name or ch in value for ch in ("\r", "\n")):
+                continue
+            if name.lower() in {"connection", "host", "range", "transfer-encoding"}:
+                continue
+            forwarded.append(f"{name}: {value}\r\n")
+        options = {
+            "rw_timeout": "30000000",
+            "reconnect": "1",
+            "reconnect_streamed": "1",
+            "reconnect_delay_max": "2",
+        }
+        if forwarded:
+            options["headers"] = "".join(forwarded)
+        return self._url, options
+

+def combine_fmp4_track_fragments(
+    sequence_number: int,
+    video_fragment: bytes,
+    audio_fragment: bytes,
+) -> bytes:
+    """Combine single-track fragments into one CMAF-style moof/mdat pair."""
+
+    def extract(fragment: bytes) -> tuple[bytearray, bytes]:
+        if len(fragment) < 24:
+            raise ValueError("Invalid fMP4 track fragment")
+        moof_size, moof_type = struct.unpack_from(">I4s", fragment, 0)
+        if moof_type != b"moof" or moof_size + 8 > len(fragment):
+            raise ValueError("Invalid fMP4 moof")
+        mdat_size, mdat_type = struct.unpack_from(">I4s", fragment, moof_size)
+        if mdat_type != b"mdat" or moof_size + mdat_size != len(fragment):
+            raise ValueError("Invalid fMP4 mdat")
+        traf_type = fragment.find(b"traf", 8, moof_size)
+        if traf_type < 4:
+            raise ValueError("Invalid fMP4 traf")
+        traf_offset = traf_type - 4
+        traf_size = struct.unpack_from(">I", fragment, traf_offset)[0]
+        if traf_offset + traf_size > moof_size:
+            raise ValueError("Invalid fMP4 traf size")
+        return (
+            bytearray(fragment[traf_offset : traf_offset + traf_size]),
+            fragment[moof_size + 8 : moof_size + mdat_size],
+        )
+
+    def set_data_offset(traf: bytearray, value: int) -> None:
+        trun_type = traf.find(b"trun")
+        if trun_type < 4:
+            raise ValueError("Invalid fMP4 trun")
+        struct.pack_into(">i", traf, trun_type + 12, value)
+
+    video_traf, video_data = extract(video_fragment)
+    audio_traf, audio_data = extract(audio_fragment)
+    mfhd = build_full_box(b"mfhd", 0, 0, struct.pack(">I", sequence_number))
+    moof = build_box(b"moof", mfhd + video_traf + audio_traf)
+    set_data_offset(video_traf, len(moof) + 8)
+    set_data_offset(audio_traf, len(moof) + 8 + len(video_data))
+    moof = build_box(b"moof", mfhd + video_traf + audio_traf)
+    return moof + build_box(b"mdat", video_data + audio_data)
+

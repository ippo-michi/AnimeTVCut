+async def _mux_mpegts_segment(
+    source: AsyncIterator[bytes] | None,
+    start_time_ms: float,
+    end_time_ms: float,
+    output_start_time_ms: float,
+    copy_video: bool,
+    copy_audio: bool,
+    input_format: str,
+    input_url: str | None,
+    input_options: dict[str, str] | None,
+    audio_languages: list[str],
+    preferred_audio: str,
+) -> bytes:
+    """Run a bounded FFmpeg remux without exposing the upstream URL."""
+    preferred_aliases = {
+        "jpn": {"jpn", "ja", "jp"},
+        "eng": {"eng", "en"},
+    }.get(preferred_audio, {preferred_audio})
+    preferred_indices = [
+        index
+        for index, language in enumerate(audio_languages)
+        if language.strip().lower() in preferred_aliases
+    ]
+    audio_order = preferred_indices + [
+        index
+        for index in range(len(audio_languages))
+        if index not in preferred_indices
+    ]
+    # When audio must be encoded, input 0 is the keyframe-bounded video
+    # slice and input 1 is a separately pre-seeked view of the same source.
+    # This gives the audio decoder packets preceding the boundary without
+    # admitting the previous video GOP into the segment.
+    audio_input_index = 1 if source is not None and input_url is not None else 0
+    audio_map_args = (
+        [
+            item
+            for index in audio_order
+            for item in ("-map", f"{audio_input_index}:a:{index}")
+        ]
+        if audio_order
+        else ["-map", f"{audio_input_index}:a?"]
+    )
+    if copy_audio:
+        # The bounded Matroska slice already begins at the boundary keyframe.
+        # Do not apply an output-side seek: with reordered H.264 frames the
+        # keyframe DTS can precede its PTS, so even a guarded seek can discard
+        # the entire first GOP. Map original packet timestamps directly onto
+        # the virtual output timeline instead.
+        end_guard_ms = 250.0
+        timing_args = [
+            "-to",
+            f"{(end_time_ms + end_guard_ms) / 1000.0:.6f}",
+        ]
+        audio_args = ["-c:a", "copy"]
+        timestamp_offset = output_start_time_ms - start_time_ms + 1.0
+    else:
+        # Independently encoded segments must share one global AAC packet
+        # grid. The current keyframe cluster contains the audio packets that
+        # own this boundary; trimming on source timestamps prevents overlap.
+        aac_frame_ms = 1024.0 * 1000.0 / 48000.0
+        audio_start_ms = (
+            int((start_time_ms + aac_frame_ms - 0.000001) / aac_frame_ms)
+            * aac_frame_ms
+        )
+        audio_end_ms = (
+            int((end_time_ms + 0.000001) / aac_frame_ms)
+            * aac_frame_ms
+        )
+        timing_args = [
+            "-to",
+            f"{(end_time_ms + 250.0) / 1000.0:.6f}",
+        ]
+        audio_args = [
+            "-af",
+            (
+                f"atrim=start={audio_start_ms / 1000.0:.6f}:"
+                f"end={audio_end_ms / 1000.0:.6f},asetpts=PTS+1024"
+            ),
+            "-c:a",
+            "aac",
+            "-ar",
+            "48000",
+            "-ac",
+            "2",
+            "-b:a",
+            "192k",
+        ]
+        timestamp_offset = output_start_time_ms - start_time_ms + 1.0
+    video_args = ["-c:v", "copy"]
+    if not copy_video:
+        video_args = [
+            "-c:v",
+            "libx264",
+            "-preset",
+            "veryfast",
+            "-force_key_frames",
+            "expr:if(isnan(prev_forced_t),1,gte(t,prev_forced_t+2))",
+        ]
+    input_args = ["-f", input_format]
+    if source is not None:
+        input_args.extend(("-i", "pipe:0"))
+    if input_url is not None:
+        # MP4 chunk tables cannot describe an arbitrary partial-file pipe.
+        # Let FFmpeg seek MediaFlow's already validated internal HTTP source.
+        # An encoded-audio second input starts early to preserve decoder
+        # history; atrim still assigns frames to the exact segment interval.
+        input_seek_ms = (
+            start_time_ms
+            if source is None
+            else max(0.0, start_time_ms - 1000.0)
+        )
+        input_args.extend(
+            ("-noaccurate_seek", "-ss", f"{input_seek_ms / 1000.0:.6f}")
+        )
+        for option, value in (input_options or {}).items():
+            input_args.extend((f"-{option}", value))
+        input_args.extend(("-i", input_url))
+    command = [
+        "ffmpeg",
+        "-hide_banner",
+        "-loglevel",
+        "error",
+        "-nostdin",
+        *input_args,
+        *timing_args,
+        "-map",
+        "0:v:0",
+        *audio_map_args,
+        "-sn",
+        "-dn",
+        *video_args,
+        *audio_args,
+        "-copyts",
+        "-avoid_negative_ts",
+        "disabled",
+        "-muxdelay",
+        "0",
+        "-muxpreload",
+        "0",
+        "-mpegts_flags",
+        "resend_headers+initial_discontinuity",
+        "-output_ts_offset",
+        f"{timestamp_offset / 1000.0:.6f}",
+        "-f",
+        "mpegts",
+        "pipe:1",
+    ]
+    process = await asyncio.create_subprocess_exec(
+        *command,
+        stdin=(
+            asyncio.subprocess.PIPE
+            if source is not None
+            else asyncio.subprocess.DEVNULL
+        ),
+        stdout=asyncio.subprocess.PIPE,
+        stderr=asyncio.subprocess.PIPE,
+    )
+
+    async def feed() -> None:
+        if source is None:
+            return
+        assert process.stdin is not None
+        try:
+            async for chunk in source:
+                process.stdin.write(chunk)
+                await process.stdin.drain()
+        except (BrokenPipeError, ConnectionResetError):
+            pass
+        finally:
+            if hasattr(source, "aclose"):
+                with contextlib.suppress(Exception):
+                    await source.aclose()
+            process.stdin.close()
+            with contextlib.suppress(BrokenPipeError, ConnectionResetError):
+                await process.stdin.wait_closed()
+
+    assert process.stdout is not None and process.stderr is not None
+    feed_task = asyncio.create_task(feed())
+    stdout_task = asyncio.create_task(process.stdout.read())
+    stderr_task = asyncio.create_task(process.stderr.read())
+    try:
+        output, stderr, _ = await asyncio.gather(
+            stdout_task, stderr_task, feed_task
+        )
+        return_code = await process.wait()
+    except BaseException:
+        process.kill()
+        await process.wait()
+        raise
+    if return_code != 0 or not output:
+        logger.warning(
+            "[hls_ts_segment] FFmpeg remux failed code=%s detail_bytes=%d",
+            return_code,
+            len(stderr),
+        )
+        raise RuntimeError("MPEG-TS remux failed")
+    return output
+

+async def _mux_mpegts_segment(
+    source: AsyncIterator[bytes],
+    start_time_ms: float,
+    end_time_ms: float,
+    output_start_time_ms: float,
+    copy_video: bool,
+    copy_audio: bool,
+    audio_languages: list[str],
+    preferred_audio: str,
+) -> bytes:
+    """Run a bounded FFmpeg remux without exposing the upstream URL."""
+    preferred_aliases = {
+        "jpn": {"jpn", "ja", "jp"},
+        "eng": {"eng", "en"},
+    }.get(preferred_audio, {preferred_audio})
+    preferred_indices = [
+        index
+        for index, language in enumerate(audio_languages)
+        if language.strip().lower() in preferred_aliases
+    ]
+    audio_order = preferred_indices + [
+        index
+        for index in range(len(audio_languages))
+        if index not in preferred_indices
+    ]
+    audio_map_args = (
+        [item for index in audio_order for item in ("-map", f"0:a:{index}")]
+        if audio_order
+        else ["-map", "0:a?"]
+    )
+    if copy_audio:
+        timing_args = [
+            "-ss",
+            f"{start_time_ms / 1000.0:.6f}",
+            "-t",
+            f"{(end_time_ms - start_time_ms) / 1000.0:.6f}",
+        ]
+        audio_args = ["-c:a", "copy"]
+        timestamp_offset = output_start_time_ms
+    else:
+        timing_args = ["-to", f"{end_time_ms / 1000.0:.6f}"]
+        audio_args = [
+            "-af",
+            f"atrim=start={start_time_ms / 1000.0:.6f},asetpts=PTS+1024",
+            "-c:a",
+            "aac",
+            "-ar",
+            "48000",
+            "-ac",
+            "2",
+            "-b:a",
+            "192k",
+        ]
+        timestamp_offset = output_start_time_ms - start_time_ms
+    command = [
+        "ffmpeg",
+        "-hide_banner",
+        "-loglevel",
+        "error",
+        "-nostdin",
+        "-f",
+        "matroska",
+        "-i",
+        "pipe:0",
+        *timing_args,
+        "-map",
+        "0:v:0",
+        *audio_map_args,
+        "-sn",
+        "-dn",
+        "-c:v",
+        "copy" if copy_video else "libx264",
+        *audio_args,
+        "-copyts",
+        "-avoid_negative_ts",
+        "disabled",
+        "-muxdelay",
+        "0",
+        "-muxpreload",
+        "0",
+        "-mpegts_flags",
+        "resend_headers",
+        "-output_ts_offset",
+        f"{timestamp_offset / 1000.0:.6f}",
+        "-f",
+        "mpegts",
+        "pipe:1",
+    ]
+    process = await asyncio.create_subprocess_exec(
+        *command,
+        stdin=asyncio.subprocess.PIPE,
+        stdout=asyncio.subprocess.PIPE,
+        stderr=asyncio.subprocess.PIPE,
+    )
+
+    async def feed() -> None:
+        assert process.stdin is not None
+        try:
+            async for chunk in source:
+                process.stdin.write(chunk)
+                await process.stdin.drain()
+        except (BrokenPipeError, ConnectionResetError):
+            pass
+        finally:
+            if hasattr(source, "aclose"):
+                with contextlib.suppress(Exception):
+                    await source.aclose()
+            process.stdin.close()
+            with contextlib.suppress(BrokenPipeError, ConnectionResetError):
+                await process.stdin.wait_closed()
+
+    assert process.stdout is not None and process.stderr is not None
+    feed_task = asyncio.create_task(feed())
+    stdout_task = asyncio.create_task(process.stdout.read())
+    stderr_task = asyncio.create_task(process.stderr.read())
+    try:
+        output, stderr, _ = await asyncio.gather(
+            stdout_task, stderr_task, feed_task
+        )
+        return_code = await process.wait()
+    except BaseException:
+        process.kill()
+        await process.wait()
+        raise
+    if return_code != 0 or not output:
+        logger.warning(
+            "[hls_ts_segment] FFmpeg remux failed code=%s detail_bytes=%d",
+            return_code,
+            len(stderr),
+        )
+        raise RuntimeError("MPEG-TS remux failed")
+    return output

+def _can_copy_mpegts_video(cue_index: MKVCueIndex | None) -> bool:
+    """MPEG-TS video passthrough is independent of audio normalization."""
+    if (
+        cue_index is None
+        or not cue_index.seek_header
+        or cue_index.video_codec_id != CODEC_ID_H264
+    ):
+        return False
+    avcc = ensure_avcc_extradata(cue_index.video_codec_private)
+    return (
+        len(avcc) >= 4
+        and avcc[0] == 1
+        and avcc[1] in _REMUX_SAFE_AVC_PROFILES
+    )
 
 
